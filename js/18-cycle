/* ============================================================================
 * HC-Analyzer  ·  18-cyclability.js
 * 역할: "Rate / Cycle" 통합 탭 안의 Cyclability(장기 수명) 하위 뷰 로직 + 뷰 전환 토글
 *
 * [설계 메모]
 *  - 기존 Rate Capability 코드(11/13번 등)는 전혀 건드리지 않습니다.
 *    이 모듈은 tab-rate 안에 추가된 #cycleSubview 요소들에만 바인딩됩니다.
 *  - 입력 데이터는 "raw 전압-용량 프로파일"이 아니라, 사이클러가 이미 사이클 단위로
 *    집계한 "사이클 요약(Cycle No. + 비용량)" 엑셀입니다. (예: ZIVE Cycle Data Report)
 *  - 표시: 주 율속 구간(형성/회복 자동 제외)만, x축 Cycle 1부터 재번호.
 *  - 메인 앱과 독립된 IIFE 스코프이며, Chart.js/xlsx/zoom 은 메인 앱이 이미 로드합니다.
 * ============================================================================ */

(function () {
    "use strict";

    // ------------------------------------------------------------------
    // 상태
    // ------------------------------------------------------------------
    let chartInstance = null;
    let parsedSeries = [];   // [{ key, label, points:[{x,y}], color, _main }]
    let activeSeriesKey = null;
    let lastFileName = "";

    const SERIES_COLORS = {
        discharge: "#60a5fa", // 방전 = 파랑
        charge:    "#f472b6", // 충전 = 핑크
        generic:   "#34d399"  // 방향 미상 = 초록
    };

    // ------------------------------------------------------------------
    // DOM (cycleSubview 내부 요소)
    // ------------------------------------------------------------------
    const dropZone     = document.getElementById("cycDropZone");
    const fileInput    = document.getElementById("cycFileInput");
    const resultArea   = document.getElementById("cycResult");
    const emptyArea    = document.getElementById("cycEmpty");
    const fileNameEl   = document.getElementById("cycFileName");
    const infoCaption  = document.getElementById("cycInfoCaption");
    const metricsEl    = document.getElementById("cycMetrics");
    const seriesToggle = document.getElementById("cycSeriesToggle");
    const canvasEl     = document.getElementById("cycChart");
    const errorEl      = document.getElementById("cycError");
    const btnPng       = document.getElementById("cycBtnPng");
    const btnCsv       = document.getElementById("cycBtnCsv");

    // 통합 업로드(자동 판별)
    const uDrop  = document.getElementById("rcUniversalDrop");
    const uInput = document.getElementById("rcUniversalInput");
    const uPick  = document.getElementById("rcUniversalPick");
    const uError = document.getElementById("rcUploadError");

    // Rate / Cycle 뷰 전환
    const rcToggle     = document.getElementById("rcToggle");
    const rateSubview  = document.getElementById("rateSubview");
    const cycleSubview = document.getElementById("cycleSubview");

    // ==================================================================
    // 0. Rate / Cycle 뷰 전환 토글
    // ==================================================================
    function showView(view) {
        if (!rateSubview || !cycleSubview) return;
        const isCycle = view === "cycle";
        rateSubview.style.display = isCycle ? "none" : "";
        cycleSubview.style.display = isCycle ? "" : "none";
        if (rcToggle) {
            rcToggle.querySelectorAll(".rc-toggle-btn").forEach(b =>
                b.classList.toggle("active", b.dataset.view === view));
        }
        // 숨김 상태에서 렌더된 차트는 크기가 틀어지므로 표시될 때 리사이즈
        if (isCycle) {
            if (chartInstance) setTimeout(() => chartInstance.resize(), 30);
        } else if (typeof triggerChartResize === "function") {
            setTimeout(triggerChartResize, 30); // 기존 Rate 차트 리사이즈(01-core.js 제공)
        }
    }

    function initToggle() {
        if (!rcToggle) return;
        rcToggle.querySelectorAll(".rc-toggle-btn").forEach(btn =>
            btn.addEventListener("click", () => showView(btn.dataset.view)));
    }

    // ==================================================================
    // 1. 업로드 UI 바인딩
    // ==================================================================
    function initUpload() {
        // 통합 드롭존(자동 판별) + Cycle 하위 뷰의 드롭존 모두 동일한 자동 라우팅 사용
        bindDropZone(uDrop, uInput);
        bindDropZone(dropZone, fileInput);
        if (uPick) uPick.addEventListener("click", (e) => { e.stopPropagation(); uInput && uInput.click(); });
        [uInput, fileInput].forEach(inp => {
            if (!inp) return;
            inp.addEventListener("change", (e) => {
                const file = e.target.files && e.target.files[0];
                if (file) handleUniversalFile(file);
                inp.value = ""; // 같은 파일 재선택 허용
            });
        });
        if (btnPng) btnPng.addEventListener("click", downloadPng);
        if (btnCsv) btnCsv.addEventListener("click", downloadCsv);
    }

    function bindDropZone(zone, input) {
        if (!zone) return;
        zone.addEventListener("click", () => input && input.click());
        ["dragenter", "dragover"].forEach(ev =>
            zone.addEventListener(ev, (e) => { e.preventDefault(); e.stopPropagation(); zone.classList.add("dragover"); }));
        ["dragleave", "drop"].forEach(ev =>
            zone.addEventListener(ev, (e) => { e.preventDefault(); e.stopPropagation(); zone.classList.remove("dragover"); }));
        zone.addEventListener("drop", (e) => {
            const file = e.dataTransfer.files && e.dataTransfer.files[0];
            if (file) handleUniversalFile(file);
        });
    }

    // ==================================================================
    // 2. 파일 읽기
    // ==================================================================
    // 파일 종류 자동 판별
    //  - 전압 컬럼이 있으면 Rate(원시 전압-용량 프로파일)
    //  - 전압 없이 Cycle No. + 용량이면 Cycle(사이클 요약)
    function detectFileType(workbook) {
        for (const sheetName of workbook.SheetNames) {
            const ws = workbook.Sheets[sheetName];
            if (!ws) continue;
            const rows = XLSX.utils.sheet_to_json(ws, { header: 1, raw: true, blankrows: false });
            const maxScan = Math.min(rows.length, 30);
            for (let i = 0; i < maxScan; i++) {
                const row = rows[i];
                if (!Array.isArray(row)) continue;
                let hasVoltage = false, hasCycleNo = false, hasCap = false;
                for (const cell of row) {
                    if (typeof cell !== "string") continue;
                    const s = cell.toLowerCase().trim();
                    if (/전압|voltage|potential/.test(s) || s === "v") hasVoltage = true;
                    if (/cycle/.test(s) && !/index/.test(s)) hasCycleNo = true;
                    if (isCapacityHeader(s)) hasCap = true;
                }
                if (hasVoltage && hasCap) return "rate";                  // 원시 전압-용량 프로파일
                if (hasCycleNo && hasCap && !hasVoltage) return "cycle";  // 사이클 요약
            }
        }
        return "unknown";
    }

    // 통합 업로드 진입점: 종류 판별 후 알맞은 뷰로 라우팅
    function handleUniversalFile(file) {
        clearUploadError();
        const reader = new FileReader();
        reader.onload = (e) => {
            let workbook;
            try {
                workbook = XLSX.read(new Uint8Array(e.target.result), { type: "array" });
            } catch (err) {
                showUploadError("파일을 읽을 수 없습니다: " + err.message);
                return;
            }
            const type = detectFileType(workbook);

            if (type === "rate") {
                // Rate 원시 데이터 → 메인 앱 파이프라인으로 처리하고 Rate 뷰로 전환
                showView("rate");
                if (typeof handleMultipleFiles === "function") {
                    handleMultipleFiles([file]);
                } else {
                    showUploadError("Rate 데이터로 인식했으나 메인 업로드 처리를 찾지 못했습니다. 사이드바에서 업로드해 주세요.");
                }
                return;
            }

            // cycle 또는 unknown → 사이클 요약 파싱 시도
            try {
                const result = parseCycleWorkbook(workbook);
                if (!result.series.length) {
                    showUploadError("데이터 형식을 인식하지 못했습니다. " +
                        "Cycle 요약(Cycle No. + Discharge Q_s) 또는 Rate 원시(전압 + 용량) 파일인지 확인해 주세요.");
                    return;
                }
                lastFileName = file.name;
                parsedSeries = result.series;
                activeSeriesKey = parsedSeries[0].key;
                showView("cycle");
                renderAll(result);
            } catch (err) {
                console.error(err);
                showUploadError("파일 처리 중 오류가 발생했습니다: " + err.message);
            }
        };
        reader.onerror = () => showUploadError("파일을 읽을 수 없습니다.");
        reader.readAsArrayBuffer(file);
    }

    // ==================================================================
    // 3. 워크북 파싱
    //    - 사이클러가 이미 집계한 "사이클 요약" 시트를 자동 탐색합니다.
    //    - 'Cycle No.' 컬럼 + 용량 컬럼(방전/충전/일반)을 찾아 시계열을 구성합니다.
    // ==================================================================
    function parseCycleWorkbook(workbook) {
        const out = { series: [], info: {} };

        // (a) 메타(Information) 시트에서 캡션 정보 추출 (있으면)
        out.info = extractInfo(workbook);

        // (b) 모든 시트를 순회하며 데이터 시트 탐색
        for (const sheetName of workbook.SheetNames) {
            const ws = workbook.Sheets[sheetName];
            if (!ws) continue;
            const rows = XLSX.utils.sheet_to_json(ws, { header: 1, raw: true, blankrows: false });
            if (!rows || rows.length < 2) continue;

            // 헤더 행 탐색: 같은 행에 'cycle' 셀과 '용량' 셀이 함께 있어야 함
            const headerRowIdx = findHeaderRow(rows);
            if (headerRowIdx === -1) continue;

            const headers = rows[headerRowIdx].map(h => String(h == null ? "" : h).trim());
            const cols = classifyColumns(headers);
            if (cols.cycleIdx === -1 || cols.caps.length === 0) continue;

            // 용량 컬럼(들)마다 시계열 구성
            cols.caps.forEach(cap => {
                const points = [];
                for (let r = headerRowIdx + 1; r < rows.length; r++) {
                    const row = rows[r];
                    if (!row) continue;

                    // 사이클 번호(없으면 순번으로 폴백)
                    let cyc = parseFloat(row[cols.cycleIdx]);
                    if (isNaN(cyc)) cyc = points.length + 1;

                    let val = parseFloat(row[cap.idx]);
                    if (isNaN(val)) continue;

                    val = val * cap.factor; // Ah/g → mAh/g 등 단위 보정
                    points.push({ x: Math.round(cyc), y: val });
                }
                if (points.length > 0) {
                    points.sort((a, b) => a.x - b.x);
                    out.series.push({
                        key: cap.key,
                        label: cap.label,
                        color: SERIES_COLORS[cap.dir] || SERIES_COLORS.generic,
                        points
                    });
                }
            });

            // 데이터 시트를 하나 찾았으면 종료 (첫 데이터 시트 우선)
            if (out.series.length) break;
        }

        // 방전 시리즈를 맨 앞으로 정렬(기본 표시 우선순위)
        out.series.sort((a, b) => rankDir(a.key) - rankDir(b.key));
        return out;
    }

    function rankDir(key) {
        if (key.indexOf("discharge") === 0) return 0;
        if (key.indexOf("charge") === 0) return 1;
        return 2;
    }

    // 헤더 행 찾기: 'cycle' 셀과 용량 셀이 같은 행에 존재하는 첫 행
    function findHeaderRow(rows) {
        const maxScan = Math.min(rows.length, 30);
        for (let i = 0; i < maxScan; i++) {
            const row = rows[i];
            if (!Array.isArray(row)) continue;
            let hasCycle = false, hasCap = false;
            for (const cell of row) {
                if (typeof cell !== "string") continue;
                const s = cell.toLowerCase();
                if (/cycle/.test(s) && !/index/.test(s)) hasCycle = true;
                if (isCapacityHeader(s)) hasCap = true;
            }
            if (hasCycle && hasCap) return i;
        }
        return -1;
    }

    function isCapacityHeader(s) {
        return /q_s|q_c|q_d|capacity|(^|[^a-z])cap([^a-z]|$)|ah\/g|mah\/g|용량/.test(s);
    }

    // 헤더 배열을 분류하여 cycle 컬럼과 용량 컬럼 목록을 반환
    function classifyColumns(headers) {
        let cycleIdx = -1;
        const caps = [];

        headers.forEach((h, idx) => {
            const s = h.toLowerCase();
            if (!s) return;

            // 사이클 번호 컬럼 (index 는 제외)
            if (cycleIdx === -1 && /cycle/.test(s) && !/index/.test(s)) {
                cycleIdx = idx;
                return;
            }
            // 용량 컬럼
            if (isCapacityHeader(s)) {
                // 단위 판정: Ah/g 이면 ×1000, mAh/g 이면 그대로
                const isAh = /ah\/g/.test(s) && !/mah\/g/.test(s);
                const factor = isAh ? 1000 : 1;

                // 방향 판정: discharge 가 charge 를 포함하므로 discharge 를 먼저 검사
                let dir = "generic";
                let label = "Specific Capacity";
                if (/discharge|방전|q_d/.test(s)) { dir = "discharge"; label = "Discharge Capacity"; }
                else if (/charge|충전|q_c/.test(s)) { dir = "charge"; label = "Charge Capacity"; }

                caps.push({ idx, key: dir + ":" + idx, dir, factor, label, rawHeader: h });
            }
        });

        return { cycleIdx, caps };
    }

    // Information/메타 시트에서 표시용 정보 추출 (있으면, 한/영 헤더 모두 지원)
    function extractInfo(workbook) {
        const info = {};
        for (const sheetName of workbook.SheetNames) {
            const ws = workbook.Sheets[sheetName];
            if (!ws) continue;
            const rows = XLSX.utils.sheet_to_json(ws, { header: 1, raw: true, blankrows: false });
            for (const row of rows) {
                if (!Array.isArray(row)) continue;
                for (const cell of row) {
                    if (typeof cell !== "string") continue;
                    const s = cell.trim();
                    if (/(test data file|시험 데이타 파일|시험 데이터 파일)/i.test(s) && !info.file) {
                        info.file = s.replace(/^.*?:\s*/, "").trim();
                    } else if (/(test duration|테스트 기간|시험 기간)/i.test(s) && !info.duration) {
                        info.duration = s.replace(/^.*?:\s*/, "").trim();
                    } else if (/(schedule file name|조건 파일명|스케줄 파일)/i.test(s) && !info.schedule) {
                        info.schedule = s.replace(/^.*?:\s*/, "").trim();
                    }
                }
            }
        }
        return info;
    }

    // ==================================================================
    // 4. 렌더링
    // ==================================================================
    function renderAll(result) {
        if (emptyArea) emptyArea.style.display = "none";
        if (resultArea) resultArea.style.display = "block";

        if (fileNameEl) fileNameEl.textContent = lastFileName;
        renderInfoCaption(result.info);
        renderSeriesToggle();
        renderDetectNote();
        renderChart();
        renderMetrics();
    }

    // 자동 감지 결과 안내
    function renderDetectNote() {
        const el = document.getElementById("cycDetectNote");
        if (!el) return;
        const series = getActiveSeries();
        if (!series) { el.style.display = "none"; return; }

        const pts = series.points;
        const m = getMain(series);
        const head = m.start;
        const tail = pts.length - 1 - m.end;
        const mainLen = m.end - m.start + 1;

        if (head + tail <= 0) {
            el.innerHTML = `전체 <strong>${mainLen}</strong> 사이클을 Cycle 1부터 표시합니다.`;
        } else {
            el.innerHTML =
                `주 율속 구간 <strong>${mainLen}</strong> 사이클(원본 Cycle ${pts[m.start].x}–${pts[m.end].x})을 ` +
                `<strong>Cycle 1부터 다시 매겨</strong> 표시합니다. ` +
                `<span style="opacity:0.75;">제외: 초기 ${head} · 말기 ${tail} 사이클 (형성/회복 등 다른 율속)</span>`;
        }
        el.style.display = "block";
    }

    function renderInfoCaption(info) {
        if (!infoCaption) return;
        const parts = [];
        const src = info.schedule || info.file || "";
        const proto = decodeProtocol(src);
        if (proto) parts.push(`프로토콜(추정): <strong>${proto}</strong>`);
        if (info.duration) parts.push(`측정기간: ${escapeHtml(info.duration)}`);
        infoCaption.innerHTML = parts.join(" &nbsp;·&nbsp; ");
        infoCaption.style.display = parts.length ? "block" : "none";
    }

    // "01x5_1x300_01x3" 같은 패턴을 "0.1C×5 → 1C×300 → 0.1C×3" 로 해석
    function decodeProtocol(name) {
        if (!name) return "";
        const matches = name.match(/(\d+)x(\d+)/g);
        if (!matches || matches.length < 1) return "";
        const decoded = matches.map(m => {
            const [rate, n] = m.split("x");
            let c = rate;
            if (/^0\d+$/.test(rate)) c = "0." + rate.replace(/^0+/, "");
            return `${c}C×${n}`;
        });
        return decoded.join(" → ");
    }

    function renderSeriesToggle() {
        if (!seriesToggle) return;
        if (parsedSeries.length <= 1) {
            seriesToggle.style.display = "none";
            seriesToggle.innerHTML = "";
            return;
        }
        seriesToggle.style.display = "flex";
        seriesToggle.innerHTML = "";
        parsedSeries.forEach(s => {
            const btn = document.createElement("button");
            btn.className = "cyc-toggle-btn" + (s.key === activeSeriesKey ? " active" : "");
            btn.textContent = s.label;
            btn.style.setProperty("--dot", s.color);
            btn.addEventListener("click", () => {
                activeSeriesKey = s.key;
                renderSeriesToggle();
                renderChart();
                renderMetrics();
            });
            seriesToggle.appendChild(btn);
        });
    }

    function getActiveSeries() {
        return parsedSeries.find(s => s.key === activeSeriesKey) || parsedSeries[0];
    }

    // ==================================================================
    // 주 율속 구간 자동 감지
    //  - C-rate 컬럼이 없으므로, 율속이 바뀔 때 용량이 계단처럼 급변하는 성질을 이용.
    //  - 사이클 간 상대 변화가 큰 지점을 경계로 구간을 나누고, 가장 긴 구간을
    //    "가장 많이 돌린 율속"의 주 구간으로 판단합니다. (초기 화성/말기 회복 자동 제외)
    // ==================================================================
    function detectMainSegment(points) {
        const n = points.length;
        if (n < 4) return { start: 0, end: n - 1 };

        const diffs = [];
        for (let i = 1; i < n; i++) {
            const prev = Math.abs(points[i - 1].y) || 1e-9;
            diffs.push(Math.abs(points[i].y - points[i - 1].y) / prev);
        }

        const sorted = [...diffs].sort((a, b) => a - b);
        const median = sorted[Math.floor(sorted.length / 2)] || 0;
        const threshold = Math.max(0.08, median * 4);

        const starts = [0];
        for (let i = 1; i < n; i++) {
            if (diffs[i - 1] > threshold) starts.push(i);
        }
        starts.push(n);

        let best = { start: 0, end: n - 1, len: 0 };
        for (let k = 0; k < starts.length - 1; k++) {
            const s = starts[k];
            const e = starts[k + 1] - 1;
            const len = e - s + 1;
            if (len > best.len) best = { start: s, end: e, len };
        }
        return { start: best.start, end: best.end };
    }

    function getMain(series) {
        if (!series._main) series._main = detectMainSegment(series.points);
        return series._main;
    }

    function renderChart() {
        if (!canvasEl) return;
        const series = getActiveSeries();
        if (!series) return;

        const m = getMain(series);
        const mainRaw = series.points.slice(m.start, m.end + 1);
        // 주 율속 구간만 · Cycle 1부터 다시 매김 (orig = 원본 사이클 번호, 툴팁용)
        const plotPts = mainRaw.map((p, i) => ({ x: i + 1, y: p.y, orig: p.x }));

        const datasets = [{
            label: series.label + " (mAh/g)",
            data: plotPts,
            borderColor: series.color,
            backgroundColor: series.color,
            pointBackgroundColor: series.color,
            pointRadius: 3,
            pointHoverRadius: 6,
            borderWidth: 1.5,
            tension: 0,
            showLine: true
        }];

        if (chartInstance) chartInstance.destroy();
        const ctx = canvasEl.getContext("2d");

        chartInstance = new Chart(ctx, {
            type: "line",
            data: { datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 300 },
                interaction: { mode: "nearest", intersect: false },
                scales: {
                    x: {
                        type: "linear",
                        title: { display: true, text: "Cycle Number", color: "#fff", font: { size: 13 } },
                        grid: { color: "rgba(255,255,255,0.05)" },
                        ticks: { color: "#9ca3af", precision: 0 }
                    },
                    y: {
                        title: { display: true, text: "Specific Capacity (mAh/g)", color: "#fff", font: { size: 13 } },
                        grid: { color: "rgba(255,255,255,0.05)" },
                        ticks: { color: "#9ca3af" },
                        beginAtZero: true
                    }
                },
                plugins: {
                    legend: {
                        display: datasets.length > 1,
                        labels: { color: "#fff", boxWidth: 14, padding: 10, usePointStyle: false }
                    },
                    tooltip: {
                        backgroundColor: "rgba(15, 20, 35, 0.95)",
                        borderColor: series.color,
                        borderWidth: 1,
                        titleColor: "#fff",
                        bodyColor: "#e5e7eb",
                        padding: 10,
                        displayColors: false,
                        callbacks: {
                            title: (items) => `Cycle ${items[0].parsed.x}`,
                            label: (item) => `${item.parsed.y.toFixed(2)} mAh/g`,
                            afterLabel: (item) => (item.raw && item.raw.orig != null) ? `원본 Cycle ${item.raw.orig}` : ""
                        }
                    }
                }
            }
        });
    }

    function renderMetrics() {
        if (!metricsEl) return;
        const series = getActiveSeries();
        if (!series || !series.points.length) { metricsEl.innerHTML = ""; return; }

        // 지표는 주 율속 구간을 대상으로 계산 (Cycle 1부터 재번호)
        const m = getMain(series);
        const pts = series.points.slice(m.start, m.end + 1);
        if (!pts.length) { metricsEl.innerHTML = ""; return; }

        const n = pts.length;
        const first = pts[0];
        const last = pts[n - 1];

        const cards = [
            { label: "사이클 수", value: `${n}`, unit: "cycles" },
            { label: "초기 용량 (Cyc 1)", value: first.y.toFixed(1), unit: "mAh/g" },
            { label: "최종 용량 (Cyc " + n + ")", value: last.y.toFixed(1), unit: "mAh/g" }
        ];

        metricsEl.innerHTML = cards.map(c => `
            <div class="cyc-metric-card">
                <div class="cyc-metric-label">${c.label}</div>
                <div class="cyc-metric-value">${c.value}<span class="cyc-metric-unit">${c.unit}</span></div>
            </div>
        `).join("");
    }

    // ==================================================================
    // 5. 내보내기
    // ==================================================================
    function downloadPng() {
        if (!chartInstance) return;
        const url = chartInstance.toBase64Image("image/png", 1);
        const a = document.createElement("a");
        a.href = url;
        a.download = (stripExt(lastFileName) || "cyclability") + "_cycle.png";
        a.click();
    }

    function downloadCsv() {
        const series = getActiveSeries();
        if (!series) return;
        const m = getMain(series);
        const pts = series.points.slice(m.start, m.end + 1);
        let csv = "Cycle Number,Original Cycle,Specific Capacity (mAh/g)\n";
        pts.forEach((p, i) => { csv += `${i + 1},${p.x},${p.y}\n`; });
        const blob = new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8;" });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = (stripExt(lastFileName) || "cyclability") + "_cycle.csv";
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }

    function stripExt(name) {
        return String(name || "").replace(/\.[^.]+$/, "");
    }

    // ==================================================================
    // 유틸
    // ==================================================================
    function showUploadError(msg) {
        const el = uError || errorEl;
        if (!el) return;
        el.textContent = msg;
        el.style.display = "block";
    }
    function clearUploadError() {
        [uError, errorEl].forEach(el => { if (el) { el.textContent = ""; el.style.display = "none"; } });
    }
    function escapeHtml(str) {
        if (typeof str !== "string") return str;
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;")
                  .replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    // ------------------------------------------------------------------
    document.addEventListener("DOMContentLoaded", () => {
        initToggle();
        initUpload();
    });
})();
